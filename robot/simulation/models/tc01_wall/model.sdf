<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="tc01_wall">
    <!-- 静态实体：生成后不会被机器人撞开。视觉墙与碰撞栏分离，
         让 LiDAR 不会提前把整面墙识别成障碍，而机器人仍会真实接触低位碰撞栏。 -->
    <static>true</static>

    <link name="wall_link">
      <collision name="wall_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <!-- 低于 Burger LiDAR 扫描平面的物理碰撞栏 -->
          <box>
            <size>0.18 4.81 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="wall_visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 4.81 0.50</size>
          </box>
        </geometry>
        <material>
          <!-- 红色，方便演示时快速确认注入成功 -->
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <!-- Gazebo contact evidence.  The Agent subscribes to this topic and
           records a collision independently of /scan. -->
      <sensor name="tc01_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>wall_collision</collision>
        </contact>
        <plugin name="tc01_contact_plugin" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/tc01</namespace>
          </ros>
          <frame_name>wall_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
