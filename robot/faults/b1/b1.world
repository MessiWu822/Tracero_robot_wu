<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <model name="b1_fixed_obstacle">
      <static>true</static>
      <pose>1 0 0.25 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.2 1.2 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
