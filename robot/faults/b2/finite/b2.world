<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <model name="b2_enclosure">
      <static>true</static>
      <link name="walls">
        <collision name="east"><pose>1.2 0 0.3 0 0 0</pose><geometry><box><size>0.1 2.5 0.6</size></box></geometry></collision>
        <visual name="east"><pose>1.2 0 0.3 0 0 0</pose><geometry><box><size>0.1 2.5 0.6</size></box></geometry></visual>
        <collision name="west"><pose>-1.2 0 0.3 0 0 0</pose><geometry><box><size>0.1 2.5 0.6</size></box></geometry></collision>
        <visual name="west"><pose>-1.2 0 0.3 0 0 0</pose><geometry><box><size>0.1 2.5 0.6</size></box></geometry></visual>
        <collision name="north"><pose>0 1.2 0.3 0 0 0</pose><geometry><box><size>2.5 0.1 0.6</size></box></geometry></collision>
        <visual name="north"><pose>0 1.2 0.3 0 0 0</pose><geometry><box><size>2.5 0.1 0.6</size></box></geometry></visual>
        <collision name="south"><pose>0 -1.2 0.3 0 0 0</pose><geometry><box><size>2.5 0.1 0.6</size></box></geometry></collision>
        <visual name="south"><pose>0 -1.2 0.3 0 0 0</pose><geometry><box><size>2.5 0.1 0.6</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
